# Rust
/target/
**/*.rs.bk

# Tauri generates these from tauri.conf.json and the capability files at build time.
crates/nazar-tray/gen/
src-tauri/gen/

# The sidecar the bundler picks up: a copy of target/release/nazar-statusline.exe under the
# target-triple name Tauri's externalBin expects. Built by scripts/build-installer.mjs, and a
# build artefact like everything else in target/.
crates/nazar-tray/binaries/

# Node and the built panel
node_modules/
dist/
*.tsbuildinfo

# Never commit an updater private key. Losing it means never shipping an update to the
# installed base again; leaking it means someone else can. See docs/RELEASE.md.
*.key
*.pem
minisign*.key

# Local machine state
*.log
.env
.env.*
.claude/settings.local.json
.DS_Store
Thumbs.db

# A real limits.json is this machine's usage data, not a fixture.
limits.json
!fixtures/limits.sample.json

# Local pack and capture artifacts
*.tgz
*.raw.json
*.raw.jsonl
fixtures/local/
# A real status-line capture is this machine's session data, not a fixture: it holds
# the working directory, the transcript path and the repository being worked on.
statusline-last.json
