{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nazar-tray",
  "version": "0.2.0",
  "identifier": "io.github.xfurqan0.nazar-tray",
  "build": {
    "frontendDist": "../../ui/dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "panel",
        "title": "nazar-tray",
        "width": 360,
        "height": 420,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": true,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Furkan Yıldız",
    "copyright": "Copyright (c) 2026 Furkan Yıldız",
    "licenseFile": "../../LICENSE",
    "category": "DeveloperTool",
    "shortDescription": "Claude Code and Codex quota in the system tray.",
    "longDescription": "A bead in your tray fills up as you burn through your 5-hour and weekly windows. Reads local files only: no credentials, no network by default.",
    "externalBin": ["binaries/nazar-statusline"],
    "resources": {
      "../../LICENSE": "LICENSE.txt",
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/main.desktop",
        "section": "devel",
        "depends": ["ca-certificates"]
      },
      "rpm": {
        "desktopTemplate": "linux/main.desktop",
        "depends": ["ca-certificates"]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/hooks.nsh",
        "compression": "lzma",
        "displayLanguageSelector": false,
        "languages": ["English", "Turkish", "SimpChinese", "Korean", "Russian", "Spanish"]
      }
    }
  }
}
